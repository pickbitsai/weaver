{
  "name": "@pickbitsai/weaver",
  "version": "0.3.0",
  "description": "PickBits Weaver: a provenance-aware, revision-safe book writing pipeline",
  "keywords": [
    "agentic-workflow",
    "book-writing",
    "narrative-state",
    "provenance",
    "revision"
  ],
  "author": "Mark Pickering and PICKBITS LLC",
  "homepage": "https://github.com/pickbitsai/weaver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickbitsai/weaver.git"
  },
  "bugs": {
    "url": "https://github.com/pickbitsai/weaver/issues"
  },
  "type": "module",
  "bin": {
    "weaver": "./scripts/weaver.mjs"
  },
  "files": [
    "contracts/",
    "contracts/integrity.schema.json",
    "docs/",
    "engine/",
    "prompts/",
    "scripts/",
    "templates/",
    "integrity.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "loop.manifest.json"
  ],
  "scripts": {
    "integrity": "node scripts/integrity.mjs --write",
    "test": "node --test test/*.test.mjs && node scripts/integrity.mjs --check",
    "test:consumer": "node test/consumer-install.mjs",
    "leakscan": "node test/leakscan.mjs",
    "smoke": "node scripts/weaver.mjs status --root templates/book",
    "status:example": "node scripts/weaver.mjs status --root templates/book",
    "preflight": "npm run leakscan && npm test && npm run smoke && npm run test:consumer",
    "prepublishOnly": "npm run preflight"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
