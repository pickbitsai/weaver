{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pickbitsai/weaver/main/contracts/project.schema.json",
  "title": "Weaver book project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "project_id",
    "kind",
    "title",
    "source_root",
    "state_root",
    "release_root"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": { "const": "book" },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "source_root": { "type": "string", "minLength": 1 },
    "state_root": { "type": "string", "minLength": 1 },
    "release_root": { "type": "string", "minLength": 1 },
    "reader_state_path": { "type": "string", "minLength": 1 },
    "outline_scene_root": { "type": "string", "minLength": 1 },
    "require_current_state_for_release": { "type": "boolean" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 4 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "chapters": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "source_book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "kind", "imported_at", "chapters", "scenes", "words", "pov_rule"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["docx", "markdown", "text", "folder"] },
        "imported_at": { "type": "string", "format": "date-time" },
        "chapters": { "type": "integer", "minimum": 1 },
        "scenes": { "type": "integer", "minimum": 1 },
        "words": { "type": "integer", "minimum": 0 },
        "pov_rule": { "enum": ["title", "none"] }
      }
    }
  }
}
