{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pickbitsai/weaver/main/contracts/backup.schema.json",
  "title": "Weaver book backup record",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "generator", "remote_name", "remote_url", "push_url", "configured_at", "last_success", "attempts"],
  "properties": {
    "$schema": { "const": "https://pickbits.ai/schemas/weaver/backup-1.json" },
    "generator": { "type": "string", "minLength": 1 },
    "remote_name": { "const": "weaver-backup" },
    "remote_url": { "type": ["string", "null"] },
    "push_url": { "type": ["string", "null"] },
    "configured_at": { "type": "string", "format": "date-time" },
    "last_success": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "commit", "branch"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "branch": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "attempts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "trigger", "result", "commit", "branch", "error", "fix", "detail", "seconds"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "trigger": { "enum": ["setup", "decision", "now", "studio"] },
          "result": { "enum": ["ok", "failed"] },
          "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
          "branch": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] },
          "fix": { "type": ["string", "null"] },
          "detail": { "type": ["string", "null"], "maxLength": 300 },
          "seconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
