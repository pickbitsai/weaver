{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pickbitsai/weaver/main/contracts/release-manifest.schema.json",
  "title": "Weaver release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "release_id",
    "lifecycle",
    "created_at",
    "source",
    "gates",
    "narrative_state",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lifecycle": { "const": "review-candidate" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_count", "chapter_count", "words", "sha256", "scenes"],
      "properties": {
        "scene_count": { "type": "integer", "minimum": 1 },
        "chapter_count": { "type": "integer", "minimum": 1 },
        "words": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "chapter", "scene", "path", "words", "sha256"],
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
              "chapter": { "type": "integer", "minimum": 1 },
              "scene": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "minLength": 1 },
              "words": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_path",
        "unapproved_high_similarity_duplicates",
        "narrative_state_stale"
      ],
      "properties": {
        "critical_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ok", "skipped", "total", "intact", "missing"],
          "properties": {
            "ok": { "type": "boolean" },
            "skipped": { "type": "boolean" },
            "total": { "type": "integer", "minimum": 0 },
            "intact": { "type": "integer", "minimum": 0 },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "scene", "anchor"],
                "properties": {
                  "id": { "type": "string" },
                  "scene": { "type": "string" },
                  "anchor": { "type": "string" }
                }
              }
            }
          }
        },
        "unapproved_high_similarity_duplicates": { "type": "integer", "minimum": 0 },
        "narrative_state_stale": { "type": "integer", "minimum": 0 }
      }
    },
    "narrative_state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "project_id", "scenes"],
          "properties": {
            "version": { "const": 1 },
            "project_id": { "type": "string" },
            "accepted_at": { "type": "string", "format": "date-time" },
            "scenes": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_sha256",
                  "state_sha256",
                  "upstream_sha256",
                  "dependency_sha256"
                ],
                "properties": {
                  "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "state_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "upstream_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "dependency_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "bytes", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
